<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 
        ImePanelView - 包含 Toolbar、Keyboard 和浮动的 layerTop
        layerTop 在内部通过负 margin 实现真正的浮动效果
    -->
    <xyz.xiao6.myboard.ui.ime.ImePanelView
        android:id="@+id/imePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 
            Layer 1: Top (Composing/Bubble/Edit area) 
            使用负的 bottom margin 让它显示在 Toolbar 上方
            这是真正的浮动层，不影响整体布局高度计算
        -->
        <FrameLayout
            android:id="@+id/layerTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="-60dp"
            android:elevation="16dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- The actual keyboard area (Toolbar + Content) -->
        <LinearLayout
            android:id="@+id/layersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Layer 2: Middle (Toolbar) -->
            <xyz.xiao6.myboard.ui.toolbar.ToolbarView
                android:id="@+id/layerMiddle"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <View
                android:id="@+id/toolbarDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/transparent" />

            <!-- Layer 3: Bottom (Input Content) -->
            <FrameLayout
                android:id="@+id/layerBottom"
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <xyz.xiao6.myboard.ui.keyboard.KeyboardSurfaceView
                    android:id="@+id/keyboardView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>

        </LinearLayout>

    </xyz.xiao6.myboard.ui.ime.ImePanelView>

    <!-- Popup overlay above keyboard (key preview + long-press candidates). -->
    <FrameLayout
        android:id="@+id/popupHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="24dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

</FrameLayout>
