{
  "version": 1,
  "themeId": "handwriting_modern",
  "name": "Modern Handwriting",
  "description": "现代化手写输入主题，参考搜狗、百度、手心输入法设计",
  "colors": {
    "background": "#FAFAFA",
    "canvas": "#FFFFFF",
    "canvas_surface": "#F8FAFC",
    "primary": "#3B82F6",
    "primary_variant": "#2563EB",
    "secondary": "#8B5CF6",
    "accent": "#F59E0B",
    "text": "#1F2937",
    "text_secondary": "#6B7280",
    "text_hint": "#9CA3AF",
    "divider": "#E5E7EB",
    "stroke": "#000000",
    "stroke_secondary": "#6B7280"
  },
  "canvas": {
    "background": { "color": "#FFFFFF" },
    "surface": { "color": "#F8FAFC" },
    "grid": { "color": "#E5E7EB", "widthDp": 1, "alpha": 0.5 },
    "paddingDp": 16,
    "cornerRadiusDp": 20,
    "elevationDp": 0
  },
  "stroke": {
    "primary": {
      "color": "#1F2937",
      "width": 6,
      "alpha": 1.0,
      "cap": "round",
      "join": "round"
    },
    "preview": {
      "color": "#3B82F6",
      "width": 4,
      "alpha": 0.5,
      "cap": "round",
      "join": "round"
    }
  },
  "candidates": {
    "position": "top",
    "floating": true,
    "background": { "color": "#FFFFFF", "alpha": 0.95 },
    "surface": { "color": "#FFFFFF" },
    "elevationDp": 8,
    "paddingHorizontalDp": 16,
    "paddingVerticalDp": 8,
    "cornerRadiusDp": 20,
    "item": {
      "background": { "color": "#F3F4F6" },
      "backgroundSelected": { "color": "#3B82F6" },
      "text": { "color": "#1F2937", "sizeSp": 16 },
      "textSelected": { "color": "#FFFFFF", "sizeSp": 16, "bold": true },
      "paddingHorizontalDp": 16,
      "paddingVerticalDp": 10,
      "cornerRadiusDp": 20,
      "marginDp": 6
    }
  },
  "controls": {
    "backButton": {
      "icon": "arrow_back",
      "sizeDp": 24,
      "tint": "#6B7280",
      "paddingDp": 12,
      "background": { "color": "#F3F4F6" }
    },
    "clearButton": {
      "icon": "delete_outline",
      "sizeDp": 24,
      "tint": "#EF4444",
      "paddingDp": 12,
      "background": { "color": "#FEE2E2" }
    },
    "recognizeButton": {
      "text": "识别",
      "textSizeSp": 16,
      "background": { "color": "#3B82F6" },
      "textColor": { "color": "#FFFFFF" },
      "cornerRadiusDp": 12,
      "paddingHorizontalDp": 20,
      "paddingVerticalDp": 12
    }
  },
  "overlay": {
    "hint": {
      "text": "在此区域手写",
      "textSizeSp": 14,
      "color": "#9CA3AF",
      "alpha": 0.6
    },
    "writingGuide": {
      "show": false,
      "color": "#E5E7EB",
      "widthDp": 1,
      "spacingDp": 20
    }
  },
  "dark": {
    "colors": {
      "background": "#0F172A",
      "canvas": "#1E293B",
      "canvas_surface": "#0F172A",
      "primary": "#60A5FA",
      "primary_variant": "#3B82F6",
      "text": "#F1F5F9",
      "text_secondary": "#94A3B8",
      "text_hint": "#64748B",
      "divider": "#334155",
      "stroke": "#E2E8F0"
    },
    "canvas": {
      "background": { "color": "#1E293B" },
      "surface": { "color": "#0F172A" }
    },
    "candidates": {
      "background": { "color": "#1E293B", "alpha": 0.95 },
      "surface": { "color": "#1E293B" },
      "item": {
        "background": { "color": "#334155" },
        "backgroundSelected": { "color": "#3B82F6" },
        "text": { "color": "#F1F5F9" },
        "textSelected": { "color": "#FFFFFF" }
      }
    },
    "controls": {
      "backButton": {
        "icon": "arrow_back",
        "tint": "#94A3B8",
        "background": { "color": "#334155" }
      },
      "clearButton": {
        "icon": "delete_outline",
        "tint": "#F87171",
        "background": { "color": "#7F1D1D" }
      }
    }
  }
}
