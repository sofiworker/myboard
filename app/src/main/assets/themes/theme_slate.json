{
  "version": 1,
  "themeId": "slate",
  "name": "Blue Slate",
  "support": {
    "layouts": [
      "qwerty",
      "numeric",
      "symbols",
      "t9",
      "zh_cn_cluster"
    ],
    "layoutSchemaVersion": 1
  },
  "colors": {
    "background": "#E9EEF3",
    "key_text": "#0B2438",
    "key_hint": "#6B7A89",
    "key_bg": "#F7FAFC",
    "key_bg_pressed": "#EBF1F5",
    "key_bg_function": "#DCE4EC",
    "key_bg_function_pressed": "#CBD5E1",
    "key_bg_accent": "#2A6FA3",
    "stroke": "#D1D9E0",
    "accent": "#2A6FA3",
    "accent_text": "#FFFFFF"
  },
  "global": {
    "font": {
      "defaultFamily": "noto_sans",
      "families": {
        "noto_sans": {
          "regularAsset": "fonts/noto_sans_regular.ttf",
          "boldAsset": "fonts/noto_sans_bold.ttf"
        }
      }
    },
    "fontSize": {
      "labelSp": 20,
      "hintSp": 11,
      "candidateSp": 18,
      "toolbarSp": 14
    },
    "icon": {
      "sizeDp": 22,
      "tint": "colors.key_text",
      "alpha": 1.0,
      "scaleMode": "fit",
      "paddingDp": 2
    },
    "labelCase": {
      "alphaCase": "AUTO",
      "respectShift": true
    },
    "paint": {
      "cornerRadiusDp": 12
    }
  },
  "icons": {
    "shift": { "source": "res", "name": "ic_shift_filled", "sizeDp": 22, "scaleMode": "fit" },
    "backspace": { "source": "res", "name": "delete_back_2_line", "sizeDp": 22, "scaleMode": "fit" },
    "enter": { "source": "res", "name": "corner_down_left_line", "sizeDp": 22, "scaleMode": "fit" },
    "space": { "source": "res", "name": "ic_space", "sizeDp": 22, "scaleMode": "fit" },
    "lang": { "source": "res", "name": "global_line", "sizeDp": 22, "scaleMode": "fit" },
    "symbols": { "source": "res", "name": "ic_symbols", "sizeDp": 22, "scaleMode": "fit" },
    "voice": { "source": "res", "name": "mic_line", "sizeDp": 22, "scaleMode": "fit" }
  },
  "layout": {
    "background": {
      "color": "colors.background"
    },
    "paddingDp": 4,
    "keySpacingDp": 5,
    "rowSpacingDp": 8,
    "extendToToolbar": true,
    "extendToCandidates": false
  },
  "toolbar": {
    "surface": {
      "background": { "color": "colors.background" },
      "stroke": { "color": "colors.stroke", "widthDp": 0 },
      "cornerRadiusDp": 12
    },
    "itemText": { "color": "colors.key_text", "sizeSp": 14 },
    "itemIcon": { "tint": "colors.key_text", "sizeDp": 22 }
  },
  "candidates": {
    "surface": {
      "background": { "color": "colors.background" },
      "stroke": { "color": "colors.stroke", "widthDp": 0 }
    },
    "candidateText": { "color": "colors.key_text", "sizeSp": 18 },
    "candidateTextSelected": { "color": "colors.accent", "bold": true },
    "divider": { "color": "colors.stroke", "widthDp": 1 }
  },
  "styles": {
    "style_alpha_key": {
      "background": { "color": "colors.key_bg" },
      "backgroundPressed": { "color": "colors.key_bg_pressed" },
      "stroke": { "color": "colors.stroke", "widthDp": 1 },
      "shadow": { "color": "#10000000", "radiusDp": 1.5, "dxDp": 0, "dyDp": 1 },
      "cornerRadiusDp": 10,
      "label": {
        "color": "colors.key_text",
        "sizeSp": 20
      },
      "hint": {
        "color": "colors.key_hint",
        "sizeSp": 10
      }
    },
    "style_function_key": {
      "background": { "color": "colors.key_bg_function" },
      "backgroundPressed": { "color": "colors.key_bg_function_pressed" },
      "stroke": { "color": "colors.stroke", "widthDp": 0.5 },
      "shadow": { "color": "#0A000000", "radiusDp": 1, "dxDp": 0, "dyDp": 1 },
      "cornerRadiusDp": 10,
      "label": { "color": "colors.key_text", "sizeSp": 16, "bold": true },
      "icon": { "tint": "colors.key_text" }
    },
    "style_function_key_important": {
      "background": { "color": "colors.key_bg_accent" },
      "backgroundPressed": { "color": "colors.key_bg_accent" },
      "stroke": { "color": "colors.stroke", "widthDp": 0 },
      "shadow": { "color": "#202A6FA3", "radiusDp": 2, "dxDp": 0, "dyDp": 1 },
      "cornerRadiusDp": 10,
      "label": { "color": "colors.accent_text", "sizeSp": 16, "bold": true },
      "icon": { "tint": "colors.accent_text" }
    }
  },
  "styleDefaults": {
    "normal": "style_alpha_key",
    "function": "style_function_key",
    "functionPrimary": "style_function_key_important"
  }
}