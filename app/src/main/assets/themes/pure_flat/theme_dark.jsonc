{
  // pure_flat dark variant — same design language, inverted surfaces
  "schemaVersion": "1.0.0",
  "id": "pure_flat",
  "name": "Pure Flat",
  "dark": true,
  "colors": {
    "background": "#121212",
    "surface": "#121212",
    "keyDefault": "#2A2A2A",
    "keyPressed": "#3A3A3A",
    "keyText": "#F5F5F5",
    "keyHint": "#9A9A9A",
    "keyFunction": "#2A2A2A",
    "keyFunctionPressed": "#3A3A3A",
    "keyFunctionText": "#F5F5F5",
    "keyAction": "#FF3B30",
    "keyActionPressed": "#E0352B",
    "keyActionText": "#FFFFFF",
    "candidateBackground": "#121212",
    "candidateText": "#F5F5F5",
    "candidateHighlight": "#FF3B30"
  },
  "keyStyles": {
    "key_default": {
      "background": "#2A2A2A",
      "pressedBackground": "#3A3A3A",
      "textColor": "#F5F5F5",
      "pressedTextColor": "#F5F5F5",
      "fontSize": 18.0,
      "cornerRadius": 16.0,
      "iconTint": "#F5F5F5",
      "decorated": true
    },
    "key_function": {
      "background": "#2A2A2A",
      "pressedBackground": "#3A3A3A",
      "textColor": "#F5F5F5",
      "pressedTextColor": "#F5F5F5",
      "fontSize": 14.0,
      "cornerRadius": 16.0,
      "iconTint": "#F5F5F5",
      "decorated": true
    },
    "key_action": {
      "background": "#FF3B30",
      "pressedBackground": "#E0352B",
      "textColor": "#FFFFFF",
      "pressedTextColor": "#FFFFFF",
      "fontSize": 16.0,
      "cornerRadius": 16.0,
      "iconTint": "#FFFFFF",
      "decorated": true
    },
    "key_space": {
      "background": "#2A2A2A",
      "pressedBackground": "#3A3A3A",
      "textColor": "#F5F5F5",
      "pressedTextColor": "#F5F5F5",
      "fontSize": 14.0,
      "cornerRadius": 18.0,
      "iconTint": "#F5F5F5",
      "decorated": true
    },
    "key_candidate": {
      "background": "#121212",
      "pressedBackground": "#2A2A2A",
      "textColor": "#F5F5F5",
      "pressedTextColor": "#FF3B30",
      "fontSize": 16.0,
      "cornerRadius": 8.0,
      "iconTint": "#F5F5F5",
      "decorated": true
    }
  },
  "feedback": {
    "haptic": {
      "key_tap": { "durationMs": 10, "amplitude": 48, "fallbackVibration": true },
      "key_long_press": { "durationMs": 28, "amplitude": 96, "fallbackVibration": true },
      "key_action": { "durationMs": 14, "amplitude": 80, "fallbackVibration": true }
    },
    "sound": {
      "key_tap": { "soundResName": "key_tap", "volume": 0.25 },
      "key_action": { "soundResName": "key_action", "volume": 0.4 },
      "key_space": { "soundResName": "key_space", "volume": 0.18 }
    }
  }
}
