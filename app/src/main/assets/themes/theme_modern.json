{
  "version": 2,
  "themeId": "modern",
  "name": "Modern",
  "support": {
    "layouts": ["qwerty", "numeric", "symbols", "t9"],
    "layoutSchemaVersion": 1
  },
  "colors": {
    "background": "#F0F4F8",
    "key_text": "#1A1C1E",
    "key_hint": "#6B7280",
    "key_bg": "#FFFFFF",
    "key_bg_pressed": "#E2E8F0",
    "key_bg_function": "#E2E8F0",
    "key_bg_function_pressed": "#CBD5E1",
    "key_bg_accent": "#3B82F6",
    "key_bg_accent_pressed": "#2563EB",
    "stroke": "#E2E8F0",
    "stroke_function": "#CBD5E1",
    "accent": "#3B82F6",
    "accent_secondary": "#8B5CF6",
    "surface": "#FFFFFF",
    "surface_variant": "#F1F5F9"
  },
  "global": {
    "font": {
      "defaultFamily": "noto_sans",
      "families": {
        "noto_sans": {
          "regularAsset": "fonts/noto_sans_regular.ttf",
          "boldAsset": "fonts/noto_sans_bold.ttf"
        }
      }
    },
    "fontSize": {
      "labelSp": 20,
      "hintSp": 11,
      "candidateSp": 18,
      "toolbarSp": 14
    },
    "icon": {
      "sizeDp": 22,
      "tint": "colors.key_text",
      "alpha": 1.0,
      "scaleMode": "fit",
      "paddingDp": 4
    },
    "labelCase": {
      "alphaCase": "AUTO",
      "respectShift": true
    },
    "paint": {
      "cornerRadiusDp": 16
    }
  },
  "icons": {
    "shift": { "source": "res", "name": "ic_shift_filled", "sizeDp": 22, "scaleMode": "fit" },
    "backspace": { "source": "res", "name": "ic_backspace_modern", "sizeDp": 22, "scaleMode": "fit" },
    "enter": { "source": "res", "name": "ic_enter_modern", "sizeDp": 22, "scaleMode": "fit" },
    "space": { "source": "res", "name": "ic_space", "sizeDp": 22, "scaleMode": "fit" },
    "lang": { "source": "res", "name": "ic_language_switch", "sizeDp": 22, "scaleMode": "fit" },
    "symbols": { "source": "res", "name": "ic_symbols", "sizeDp": 22, "scaleMode": "fit" },
    "voice": { "source": "res", "name": "ic_voice_input", "sizeDp": 22, "scaleMode": "fit" }
  },
  "layout": {
    "background": { "color": "colors.background" },
    "keySpacingDp": 6,
    "rowSpacingDp": 8,
    "paddingDp": 8,
    "extendToToolbar": true,
    "extendToCandidates": false
  },
  "toolbar": {
    "surface": {
      "background": { "color": "colors.surface" },
      "stroke": { "color": "colors.stroke", "widthDp": 1 },
      "cornerRadiusDp": 20,
      "elevationDp": 2
    },
    "itemText": { "color": "#374151", "sizeSp": 14 },
    "itemIcon": { "tint": "#374151", "sizeDp": 22 }
  },
  "candidates": {
    "surface": {
      "background": { "color": "colors.surface" },
      "stroke": { "color": "colors.stroke", "widthDp": 1 },
      "cornerRadiusDp": 20
    },
    "candidateText": { "color": "colors.key_text", "sizeSp": 18 },
    "candidateTextSelected": { "color": "colors.accent", "bold": true },
    "divider": { "color": "colors.stroke", "widthDp": 1 }
  },
  "composingPopup": {
    "surface": {
      "background": { "color": "colors.surface" },
      "stroke": { "color": "colors.stroke", "widthDp": 1 },
      "cornerRadiusDp": 16,
      "elevationDp": 4
    },
    "text": { "color": "colors.key_text" },
    "textSelected": { "color": "colors.accent", "bold": true }
  },
  "keyPopup": {
    "surface": {
      "background": { "color": "colors.surface" },
      "stroke": { "color": "colors.stroke", "widthDp": 0 },
      "cornerRadiusDp": 16,
      "elevationDp": 8,
      "shadowColor": "#40000000"
    },
    "text": { "color": "colors.key_text", "sizeSp": 32, "bold": true },
    "textSelected": { "color": "#FFFFFF" },
    "item": {
      "cornerRadiusDp": 14,
      "paddingDp": 12,
      "selectedBackground": "colors.accent"
    }
  },
  "styles": {
    "style_alpha_key": {
      "background": { "color": "colors.key_bg" },
      "backgroundPressed": { "color": "colors.key_bg_pressed" },
      "stroke": { "color": "colors.stroke", "widthDp": 0 },
      "shadow": { "color": "#0A000000", "radiusDp": 1, "dxDp": 0, "dyDp": 1 },
      "cornerRadiusDp": 16,
      "label": { "color": "colors.key_text", "sizeSp": 20, "bold": false },
      "hint": { "color": "colors.key_hint", "sizeSp": 11 }
    },
    "style_function_key": {
      "background": { "color": "colors.key_bg_function" },
      "backgroundPressed": { "color": "colors.key_bg_function_pressed" },
      "stroke": { "color": "colors.stroke_function", "widthDp": 0 },
      "shadow": { "color": "#0A000000", "radiusDp": 1, "dxDp": 0, "dyDp": 1 },
      "cornerRadiusDp": 16,
      "label": { "color": "#4B5563", "sizeSp": 16, "bold": true },
      "hint": { "color": "colors.key_hint", "sizeSp": 10 },
      "icon": { "sizeDp": 22, "tint": "#4B5563", "alpha": 1.0, "scaleMode": "fit" }
    },
    "style_function_key_important": {
      "background": { "color": "colors.key_bg_accent" },
      "backgroundPressed": { "color": "colors.key_bg_accent_pressed" },
      "stroke": { "color": "#00000000", "widthDp": 0 },
      "shadow": { "color": "#203B82F6", "radiusDp": 4, "dxDp": 0, "dyDp": 2 },
      "cornerRadiusDp": 16,
      "label": { "color": "#FFFFFF", "sizeSp": 16, "bold": true },
      "hint": { "color": "#B3FFFFFF", "sizeSp": 10 },
      "icon": { "sizeDp": 22, "tint": "#FFFFFF", "alpha": 1.0, "scaleMode": "fit" }
    },
    "style_space_key": {
      "background": { "color": "colors.key_bg_function" },
      "backgroundPressed": { "color": "colors.key_bg_function_pressed" },
      "stroke": { "color": "colors.stroke_function", "widthDp": 0 },
      "shadow": { "color": "#0A000000", "radiusDp": 1, "dxDp": 0, "dyDp": 1 },
      "cornerRadiusDp": 16,
      "label": { "color": "#9CA3AF", "sizeSp": 14, "bold": false },
      "hint": { "color": "colors.key_hint", "sizeSp": 10 }
    }
  },
  "styleDefaults": {
    "normal": "style_alpha_key",
    "function": "style_function_key",
    "functionPrimary": "style_function_key_important",
    "functionDanger": "style_function_key",
    "functionToggle": "style_function_key",
    "space": "style_space_key"
  },
  "dark": {
    "colors": {
      "background": "#0F172A",
      "key_text": "#F1F5F9",
      "key_hint": "#94A3B8",
      "key_bg": "#1E293B",
      "key_bg_pressed": "#334155",
      "key_bg_function": "#334155",
      "key_bg_function_pressed": "#475569",
      "key_bg_accent": "#3B82F6",
      "key_bg_accent_pressed": "#60A5FA",
      "stroke": "#334155",
      "stroke_function": "#475569",
      "accent": "#60A5FA",
      "accent_secondary": "#A78BFA",
      "surface": "#1E293B",
      "surface_variant": "#0F172A"
    },
    "layout": {
      "background": { "color": "colors.background" }
    },
    "toolbar": {
      "surface": {
        "background": { "color": "colors.surface" },
        "stroke": { "color": "colors.stroke", "widthDp": 1 }
      },
      "itemText": { "color": "#D1D5DB" },
      "itemIcon": { "tint": "#D1D5DB" }
    },
    "candidates": {
      "surface": {
        "background": { "color": "colors.surface" },
        "stroke": { "color": "colors.stroke", "widthDp": 1 }
      },
      "candidateText": { "color": "colors.key_text", "sizeSp": 18 },
      "candidateTextSelected": { "color": "colors.accent", "bold": true },
      "divider": { "color": "colors.stroke", "widthDp": 1 }
    },
    "styles": {
      "style_alpha_key": {
        "background": { "color": "colors.key_bg" },
        "backgroundPressed": { "color": "colors.key_bg_pressed" },
        "stroke": { "color": "colors.stroke", "widthDp": 0 },
        "shadow": { "color": "#40000000", "radiusDp": 2, "dxDp": 0, "dyDp": 1 },
        "label": { "color": "colors.key_text", "sizeSp": 20 },
        "hint": { "color": "colors.key_hint", "sizeSp": 11 }
      },
      "style_function_key": {
        "background": { "color": "colors.key_bg_function" },
        "backgroundPressed": { "color": "colors.key_bg_function_pressed" },
        "stroke": { "color": "colors.stroke_function", "widthDp": 0 },
        "shadow": { "color": "#40000000", "radiusDp": 2, "dxDp": 0, "dyDp": 1 },
        "label": { "color": "#CBD5E1", "sizeSp": 16, "bold": true },
        "icon": { "tint": "#CBD5E1" }
      },
      "style_function_key_important": {
        "background": { "color": "colors.key_bg_accent" },
        "backgroundPressed": { "color": "colors.key_bg_accent_pressed" },
        "stroke": { "color": "#00000000", "widthDp": 0 },
        "shadow": { "color": "#403B82F6", "radiusDp": 4, "dxDp": 0, "dyDp": 2 },
        "label": { "color": "#FFFFFF", "sizeSp": 16, "bold": true },
        "icon": { "tint": "#FFFFFF" }
      },
      "style_space_key": {
        "background": { "color": "colors.key_bg_function" },
        "backgroundPressed": { "color": "colors.key_bg_function_pressed" },
        "stroke": { "color": "colors.stroke_function", "widthDp": 0 },
        "shadow": { "color": "#40000000", "radiusDp": 2, "dxDp": 0, "dyDp": 1 },
        "cornerRadiusDp": 16,
        "label": { "color": "#64748B", "sizeSp": 14 }
      }
    },
    "keyPopup": {
      "surface": {
        "background": { "color": "colors.surface" },
        "stroke": { "color": "colors.stroke", "widthDp": 0 },
        "cornerRadiusDp": 16,
        "elevationDp": 8,
        "shadowColor": "#80000000"
      },
      "text": { "color": "colors.key_text", "sizeSp": 32, "bold": true },
      "textSelected": { "color": "#FFFFFF" },
      "item": {
        "cornerRadiusDp": 14,
        "paddingDp": 12,
        "selectedBackground": "colors.accent"
      }
    }
  }
}
