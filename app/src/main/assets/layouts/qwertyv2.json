{
  "type": "layout",
  "id": "std_qwerty_v1",
  "version": 1,
  "meta": {
    "name": "标准极客键盘",
    "author": "Gemini",
    "description": "自适应 QWERTY 布局，支持动态工具栏切换"
  },
  "layout": {
    "direction": "vertical",
    "regions": [
      {
        "id": "top_container",
        "role": "header",
        "layoutType": "stack",
        "size": { "width": "100%", "height": "45dp" },
        "children": [
          {
            "type": "group",
            "id": "candidate_bar",
            "layoutType": "linear",
            "linear": { "orientation": "horizontal", "gravity": "start" },
            "bindings": { "visibleWhen": "state.composing" },
            "scroll": { "enabled": true, "direction": "horizontal" },
            "children": [
              { "type": "candidate", "id": "cand_item", "size": { "width": "wrap", "height": "match" } }
            ]
          },
          {
            "type": "group",
            "id": "tool_bar",
            "layoutType": "linear",
            "linear": { "orientation": "horizontal", "gravity": "space_between" },
            "bindings": { "visibleWhen": "!state.composing" },
            "children": [
              { "type": "button", "id": "btn_settings", "content": { "icon": "ic_settings" }, "actions": { "TAP": { "actionType": "OPEN_PANEL", "payload": { "id": "settings" } } } },
              { "type": "button", "id": "btn_emoji", "content": { "icon": "ic_emoji" }, "actions": { "TAP": { "actionType": "SWITCH_LAYER", "payload": { "id": "emoji" } } } },
              { "type": "button", "id": "btn_close", "content": { "icon": "ic_keyboard_hide" }, "actions": { "TAP": { "actionType": "CLOSE_PANEL" } } }
            ]
          }
        ]
      },
      {
        "id": "main_keyboard",
        "role": "keyboard",
        "layoutType": "rows",
        "padding": { "top": 5, "bottom": 5 },
        "children": [
          {
            "type": "row",
            "id": "row_1",
            "linear": { "orientation": "horizontal", "gap": 4 },
            "children": [
              { "type": "key", "id": "key_q", "layout": { "weight": 1 }, "content": { "label": "Q" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "q" } } } },
              { "type": "key", "id": "key_w", "layout": { "weight": 1 }, "content": { "label": "W" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "w" } } } },
              { "type": "key", "id": "key_e", "layout": { "weight": 1 }, "content": { "label": "E" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "e" } } } },
              { "type": "key", "id": "key_r", "layout": { "weight": 1 }, "content": { "label": "R" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "r" } } } },
              { "type": "key", "id": "key_t", "layout": { "weight": 1 }, "content": { "label": "T" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "t" } } } },
              { "type": "key", "id": "key_y", "layout": { "weight": 1 }, "content": { "label": "Y" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "y" } } } },
              { "type": "key", "id": "key_u", "layout": { "weight": 1 }, "content": { "label": "U" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "u" } } } },
              { "type": "key", "id": "key_i", "layout": { "weight": 1 }, "content": { "label": "I" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "i" } } } },
              { "type": "key", "id": "key_o", "layout": { "weight": 1 }, "content": { "label": "O" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "o" } } } },
              { "type": "key", "id": "key_p", "layout": { "weight": 1 }, "content": { "label": "P" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "text": "p" } } } }
            ]
          },
          {
            "type": "row",
            "id": "row_bottom",
            "linear": { "orientation": "horizontal", "gap": 4 },
            "children": [
              { "type": "key", "id": "key_sym", "layout": { "weight": 1.5 }, "content": { "label": "?123" }, "actions": { "TAP": { "actionType": "SWITCH_MODE", "payload": { "mode": "symbol" } } } },
              { "type": "key", "id": "key_comma", "layout": { "weight": 1 }, "content": { "label": "," }, "actions": { "TAP": { "actionType": "COMMIT_TEXT", "payload": { "text": "," } } } },
              { "type": "key", "id": "key_space", "layout": { "weight": 4 }, "content": { "label": "空格" }, "actions": { "TAP": { "actionType": "SPACE" }, "SWIPE_LEFT": { "actionType": "MOVE_CURSOR", "payload": { "direction": "left" } } } },
              { "type": "key", "id": "key_dot", "layout": { "weight": 1 }, "content": { "label": "." }, "actions": { "TAP": { "actionType": "COMMIT_TEXT", "payload": { "text": "." } } } },
              { "type": "key", "id": "key_enter", "layout": { "weight": 1.5 }, "content": { "label": "确认" }, "styleRef": "action_key", "actions": { "TAP": { "actionType": "ENTER" } } }
            ]
          }
        ]
      }
    ]
  },
  "styles": {
    "default": {
      "background": "#FFFFFF",
      "textColor": "#000000",
      "cornerRadius": 4,
      "fontSize": 18
    },
    "action_key": {
      "background": "#4285F4",
      "textColor": "#FFFFFF",
      "fontWeight": "bold"
    }
  }
}