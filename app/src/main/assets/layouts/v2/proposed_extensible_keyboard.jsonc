{
  // Reference proposal for a soft-keyboard layout definition.
  //
  // Scope:
  // - Defines only the keyboard surface: rows, keys, geometry, gestures, popups,
  //   hints, structural arrangements, and key-level state computation.
  // - Does not define candidate bars, toolbars, emoji/clipboard panels, settings
  //   pages, theme colors, or runtime candidate data.
  //
  // Design notes from FlorisBoard / LatinIME / AnySoftKeyboard / fcitx5-android /
  // YuyanIme / Trime:
  // - Layout arrangement and theme are separate.
  // - Alpha/symbol/number/phone are structural arrangements.
  // - Shift/caps/editor variation/language label replacement are key-level
  //   computations where possible.
  // - User customization should patch stable anchors, not edit a whole UI tree.

  "type": "softKeyboardLayout",
  "schemaVersion": 2,
  "id": "reference.qwerty.extensible",
  "revision": 1,

  "meta": {
    "name": "Reference Extensible QWERTY",
    "family": "qwerty",
    "tags": ["qwerty", "latin", "pinyin", "extensible"],
    "description": "A keyboard-only layout proposal with composable arrangements, semantic roles, computed keys, and stable user override points."
  },

  "runtimeContract": {
    // These are state axes consumed by the layout evaluator.
    // They are not UI panels.
    "stateAxes": {
      "arrangement": ["alpha", "symbols", "symbolsShift", "number", "phone"],
      "modifier": ["none", "shift", "capsLock"],
      "language": ["current", "target"],
      "editorVariation": ["normal", "email", "uri", "password", "number", "phone"],
      "layoutDirection": ["ltr", "rtl"]
    },

    "updatePolicy": {
      // Recompute labels/actions in place. Do not rebuild the keyboard.
      "keyLevel": ["modifier", "language", "editorVariation", "layoutDirection", "enterAction"],

      // Switch to another arrangement. This may rebuild/reuse a keyboard object.
      "structural": ["arrangement"],

      // Outside this file. Panels are owned by the IME window layer.
      "externalPanel": ["candidate", "toolbar", "emoji", "clipboard", "settings"]
    },

    "languageSwitchPolicy": {
      "preferSameArrangementId": true,
      "ifSameArrangementExists": "replaceKeyDataOnly",
      "ifMissingSameArrangement": "switchToLanguageManagedArrangement",
      "fallback": "languageDefaultArrangement"
    }
  },

  "geometry": {
    "model": "weightedRows",
    "coordinate": "rowWeight",
    "size": {
      "width": "100%",
      "height": {
        "default": "260dp",
        "min": "190dp",
        "max": "360dp"
      }
    },
    "padding": {
      "left": { "default": "6dp", "min": "0dp", "max": "18dp" },
      "right": { "default": "6dp", "min": "0dp", "max": "18dp" },
      "top": { "default": "6dp", "min": "0dp", "max": "18dp" },
      "bottom": { "default": "6dp", "min": "0dp", "max": "18dp" }
    },
    "gap": {
      "horizontal": { "default": "4dp", "min": "0dp", "max": "10dp" },
      "vertical": { "default": "5dp", "min": "0dp", "max": "10dp" }
    },
    "touch": {
      "outset": { "default": "2dp", "min": "0dp", "max": "10dp" },
      "nearestKeyFallback": "insideSameRow",
      "separateVisualAndHitBounds": true
    },
    "row": {
      "height": "1fr",
      "baselineColumns": 10
    }
  },

  "themeContract": {
    // Layout exports semantic attributes. Theme files decide actual colors,
    // shapes, typography, pressed states, and state-specific selectors.
    "exportAttributes": [
      "key.id",
      "key.code",
      "key.role",
      "key.variant",
      "key.modifierState",
      "keyboard.arrangement",
      "keyboard.layoutDirection"
    ],
    "roles": {
      "character": { "defaultVariant": "normal" },
      "modifier": { "defaultVariant": "function" },
      "delete": { "defaultVariant": "function", "repeatable": true },
      "enter": { "defaultVariant": "accent" },
      "space": { "defaultVariant": "space" },
      "languageSwitch": { "defaultVariant": "function" },
      "arrangementSwitch": { "defaultVariant": "function" },
      "spacer": { "defaultVariant": "transparent" }
    }
  },

  "keyTemplates": {
    "character": {
      "role": "character",
      "width": 1,
      "repeatable": false,
      "computed": {
        "label": {
          "select": "modifier",
          "none": { "source": "key.output" },
          "shift": { "source": "key.output", "transform": "uppercase" },
          "capsLock": { "source": "key.output", "transform": "uppercase" }
        },
        "output": {
          "select": "modifier",
          "none": { "source": "key.output" },
          "shift": { "source": "key.output", "transform": "uppercase", "consumeModifier": true },
          "capsLock": { "source": "key.output", "transform": "uppercase" }
        }
      },
      "gestures": {
        "tap": [{ "type": "commitComputedOutput" }],
        "longPress": [{ "type": "showPopup", "popupFrom": "key.popup" }],
        "flickUp": [{ "type": "commitHint", "hint": "top" }]
      }
    },

    "action": {
      "role": "arrangementSwitch",
      "width": 1.35,
      "repeatable": false,
      "gestures": {}
    },

    "repeatAction": {
      "extends": "action",
      "repeatable": true,
      "repeat": {
        "initialDelay": "420ms",
        "interval": "46ms",
        "accelerate": true
      }
    },

    "space": {
      "role": "space",
      "width": 4.2,
      "computed": {
        "label": { "source": "runtime.inputModeName", "fallback": "space" }
      },
      "gestures": {
        "tap": [{ "type": "commitText", "text": " " }],
        "swipeLeft": [{ "type": "moveCursor", "direction": "left", "unit": "character" }],
        "swipeRight": [{ "type": "moveCursor", "direction": "right", "unit": "character" }],
        "longPress": [{ "type": "showPopup", "popup": "spaceMenu" }]
      }
    },

    "spacer": {
      "role": "spacer",
      "width": 1,
      "focusable": false,
      "touchable": false
    }
  },

  "actionMacros": {
    "deleteSmart": [
      { "when": { "composition": "notEmpty" }, "do": [{ "type": "deleteComposition", "count": 1 }] },
      { "else": [{ "type": "sendKeyEvent", "key": "BACKSPACE" }] }
    ],
    "enterSmart": [
      { "when": { "editorAction": "search" }, "do": [{ "type": "performEditorAction", "action": "search" }] },
      { "when": { "editorAction": "send" }, "do": [{ "type": "performEditorAction", "action": "send" }] },
      { "when": { "editorAction": "next" }, "do": [{ "type": "performEditorAction", "action": "next" }] },
      { "when": { "editorAction": "done" }, "do": [{ "type": "performEditorAction", "action": "done" }] },
      { "else": [{ "type": "sendKeyEvent", "key": "ENTER" }] }
    ],
    "toggleShift": [
      { "type": "toggleModifier", "modifier": "shift" }
    ],
    "lockCaps": [
      { "type": "setModifier", "modifier": "capsLock" }
    ],
    "switchLanguage": [
      { "type": "switchLanguage", "policy": "runtimeContract.languageSwitchPolicy" }
    ]
  },

  "popups": {
    "spaceMenu": {
      "items": [
        { "label": "left", "action": { "type": "moveCursor", "direction": "left" } },
        { "label": "right", "action": { "type": "moveCursor", "direction": "right" } },
        { "label": "tab", "action": { "type": "commitText", "text": "\t" } }
      ]
    },
    "latinA": { "items": ["á", "à", "â", "ä", "ã", "å", "æ"] },
    "latinE": { "items": ["é", "è", "ê", "ë", "ē"] },
    "latinI": { "items": ["í", "ì", "î", "ï", "ī"] },
    "latinO": { "items": ["ó", "ò", "ô", "ö", "õ", "ø", "œ"] },
    "latinU": { "items": ["ú", "ù", "û", "ü", "ū"] }
  },

  "keymaps": {
    "alpha.qwerty": {
      "rows": {
        "top": [
          { "id": "q", "template": "character", "code": 113, "output": "q", "hint": { "top": "1" }, "popup": ["1"] },
          { "id": "w", "template": "character", "code": 119, "output": "w", "hint": { "top": "2" }, "popup": ["2"] },
          { "id": "e", "template": "character", "code": 101, "output": "e", "hint": { "top": "3" }, "popup": { "ref": "latinE" } },
          { "id": "r", "template": "character", "code": 114, "output": "r", "hint": { "top": "4" } },
          { "id": "t", "template": "character", "code": 116, "output": "t", "hint": { "top": "5" } },
          { "id": "y", "template": "character", "code": 121, "output": "y", "hint": { "top": "6" } },
          { "id": "u", "template": "character", "code": 117, "output": "u", "hint": { "top": "7" }, "popup": { "ref": "latinU" } },
          { "id": "i", "template": "character", "code": 105, "output": "i", "hint": { "top": "8" }, "popup": { "ref": "latinI" } },
          { "id": "o", "template": "character", "code": 111, "output": "o", "hint": { "top": "9" }, "popup": { "ref": "latinO" } },
          { "id": "p", "template": "character", "code": 112, "output": "p", "hint": { "top": "0" } }
        ],
        "home": [
          { "id": "home.leftPad", "template": "spacer", "width": 0.5 },
          { "id": "a", "template": "character", "code": 97, "output": "a", "popup": { "ref": "latinA" } },
          { "id": "s", "template": "character", "code": 115, "output": "s" },
          { "id": "d", "template": "character", "code": 100, "output": "d" },
          { "id": "f", "template": "character", "code": 102, "output": "f" },
          { "id": "g", "template": "character", "code": 103, "output": "g" },
          { "id": "h", "template": "character", "code": 104, "output": "h" },
          { "id": "j", "template": "character", "code": 106, "output": "j" },
          { "id": "k", "template": "character", "code": 107, "output": "k" },
          { "id": "l", "template": "character", "code": 108, "output": "l" },
          { "id": "home.rightPad", "template": "spacer", "width": 0.5 }
        ],
        "bottom": [
          {
            "id": "shift",
            "template": "action",
            "role": "modifier",
            "code": "SHIFT",
            "icon": {
              "select": "modifier",
              "none": "shift",
              "shift": "shift-on",
              "capsLock": "shift-lock"
            },
            "gestures": {
              "tap": [{ "ref": "toggleShift" }],
              "doubleTap": [{ "ref": "lockCaps" }]
            }
          },
          { "id": "z", "template": "character", "code": 122, "output": "z" },
          { "id": "x", "template": "character", "code": 120, "output": "x" },
          { "id": "c", "template": "character", "code": 99, "output": "c" },
          { "id": "v", "template": "character", "code": 118, "output": "v" },
          { "id": "b", "template": "character", "code": 98, "output": "b" },
          { "id": "n", "template": "character", "code": 110, "output": "n" },
          { "id": "m", "template": "character", "code": 109, "output": "m" },
          {
            "id": "delete",
            "template": "repeatAction",
            "role": "delete",
            "code": "BACKSPACE",
            "icon": "backspace",
            "gestures": {
              "tap": [{ "ref": "deleteSmart" }],
              "repeat": [{ "ref": "deleteSmart" }],
              "swipeLeft": [{ "type": "deleteWord" }]
            }
          }
        ]
      }
    },

    "symbols.primary": {
      "rows": {
        "top": ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        "home": ["@", "#", "$", "_", "&", "-", "+", "(", ")", "/"],
        "bottom": ["*", "\"", "'", ":", ";", "!", "?", ",", "."]
      }
    },

    "symbols.secondary": {
      "rows": {
        "top": ["~", "`", "|", "•", "√", "π", "÷", "×", "¶", "∆"],
        "home": ["£", "¢", "€", "¥", "^", "°", "=", "{", "}", "\\"],
        "bottom": ["%", "©", "®", "™", "✓", "[", "]", "<", ">"]
      }
    },

    "number.pad": {
      "rows": {
        "r1": ["1", "2", "3"],
        "r2": ["4", "5", "6"],
        "r3": ["7", "8", "9"],
        "r4": [".", "0", "delete"]
      }
    }
  },

  "modifierRows": {
    "alpha.bottom": [
      {
        "id": "toSymbols",
        "template": "action",
        "role": "arrangementSwitch",
        "label": "?123",
        "gestures": { "tap": [{ "type": "switchArrangement", "arrangement": "symbols" }] }
      },
      {
        "id": "variationLeft",
        "template": "character",
        "role": "character",
        "computed": {
          "label": {
            "select": "editorVariation",
            "email": "@",
            "uri": "/",
            "default": ","
          },
          "output": {
            "select": "editorVariation",
            "email": "@",
            "uri": "/",
            "default": ","
          }
        }
      },
      {
        "id": "language",
        "template": "action",
        "role": "languageSwitch",
        "icon": "language",
        "gestures": { "tap": [{ "ref": "switchLanguage" }] }
      },
      { "id": "space", "template": "space" },
      {
        "id": "variationRight",
        "template": "character",
        "role": "character",
        "computed": {
          "label": {
            "select": "editorVariation",
            "email": ".",
            "uri": ".",
            "default": "."
          },
          "output": {
            "select": "editorVariation",
            "email": ".",
            "uri": ".",
            "default": "."
          }
        }
      },
      {
        "id": "enter",
        "template": "action",
        "role": "enter",
        "code": "ENTER",
        "icon": {
          "select": "enterAction",
          "search": "search",
          "send": "send",
          "next": "arrow-right",
          "done": "check",
          "default": "enter"
        },
        "gestures": { "tap": [{ "ref": "enterSmart" }] }
      }
    ],

    "symbols.bottom": [
      {
        "id": "toAlpha",
        "template": "action",
        "role": "arrangementSwitch",
        "label": "ABC",
        "gestures": { "tap": [{ "type": "switchArrangement", "arrangement": "alpha" }] }
      },
      {
        "id": "moreSymbols",
        "template": "action",
        "role": "modifier",
        "label": "=\\<",
        "gestures": { "tap": [{ "type": "switchArrangement", "arrangement": "symbolsShift" }] }
      },
      { "id": "space", "template": "space" },
      {
        "id": "enter",
        "template": "action",
        "role": "enter",
        "code": "ENTER",
        "icon": "enter",
        "gestures": { "tap": [{ "ref": "enterSmart" }] }
      }
    ]
  },

  "arrangements": {
    "alpha": {
      "type": "weightedRows",
      "identity": {
        "sameShapeAcrossLanguages": true,
        "languageDataPatchable": true
      },
      "rows": [
        { "id": "alpha.top", "from": "keymaps.alpha.qwerty.rows.top" },
        { "id": "alpha.home", "from": "keymaps.alpha.qwerty.rows.home" },
        { "id": "alpha.bottomLetters", "from": "keymaps.alpha.qwerty.rows.bottom" },
        { "id": "alpha.bottomControls", "from": "modifierRows.alpha.bottom" }
      ],
      "hints": {
        "source": "keymaps.symbols.primary",
        "placement": "top",
        "mapping": "sameIndexWhenCompatible"
      }
    },

    "symbols": {
      "type": "weightedRows",
      "rows": [
        { "id": "symbols.top", "stringKeys": { "from": "keymaps.symbols.primary.rows.top", "template": "character" } },
        { "id": "symbols.home", "stringKeys": { "from": "keymaps.symbols.primary.rows.home", "template": "character" } },
        { "id": "symbols.bottom", "stringKeys": { "from": "keymaps.symbols.primary.rows.bottom", "template": "character" } },
        { "id": "symbols.controls", "from": "modifierRows.symbols.bottom" }
      ]
    },

    "symbolsShift": {
      "type": "weightedRows",
      "rows": [
        { "id": "symbolsShift.top", "stringKeys": { "from": "keymaps.symbols.secondary.rows.top", "template": "character" } },
        { "id": "symbolsShift.home", "stringKeys": { "from": "keymaps.symbols.secondary.rows.home", "template": "character" } },
        { "id": "symbolsShift.bottom", "stringKeys": { "from": "keymaps.symbols.secondary.rows.bottom", "template": "character" } },
        { "id": "symbolsShift.controls", "from": "modifierRows.symbols.bottom" }
      ]
    },

    "number": {
      "type": "grid",
      "columns": 3,
      "cellHeight": "1fr",
      "keys": { "from": "keymaps.number.pad", "template": "character" }
    }
  },

  "customization": {
    // Stable anchors are the public API for user patches.
    "stableAnchors": [
      "arrangements.alpha.rows.alpha.top",
      "arrangements.alpha.rows.alpha.home",
      "arrangements.alpha.rows.alpha.bottomLetters",
      "arrangements.alpha.rows.alpha.bottomControls",
      "modifierRows.alpha.bottom",
      "keys.shift",
      "keys.delete",
      "keys.language",
      "keys.space",
      "keys.enter",
      "popups.*",
      "geometry.padding",
      "geometry.gap",
      "geometry.touch"
    ],

    "allowedPatchOps": [
      "replaceKey",
      "replaceRow",
      "insertKeyBefore",
      "insertKeyAfter",
      "removeKey",
      "replaceGesture",
      "addPopupItem",
      "replacePopup",
      "replaceHint",
      "overrideWidth",
      "overrideGeometryParam",
      "overrideLanguageKeyData"
    ],

    "examples": [
      {
        "op": "replaceGesture",
        "target": "keys.space.gestures.longPress",
        "value": [{ "type": "showInputMethodPicker" }]
      },
      {
        "op": "overrideLanguageKeyData",
        "target": "keys.q",
        "when": { "language": "zh-Hans", "inputMode": "pinyin" },
        "value": { "output": "q", "label": "q", "hint": { "top": "1" } }
      }
    ]
  },

  "validation": {
    "requireUniqueKeyIdsWithinArrangement": true,
    "requireKnownTemplateRefs": true,
    "requireKnownPopupRefs": true,
    "requireKnownActionMacroRefs": true,
    "forbidThemeColorsInLayout": true,
    "forbidExternalPanelNodes": true,
    "warnWhenRowWeightSumChangesAcrossLanguages": true,
    "warnWhenLanguageSwitchWouldRequireFullRebuild": true
  }
}
