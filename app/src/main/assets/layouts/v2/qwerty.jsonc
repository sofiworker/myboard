{
  "type": "layout",
  "id": "qwerty_default",
  "version": 1,
  "meta": {
    "name": "Qwerty Default"
  },
  "state": {
    "defaultLayer": "default",
    "supportedLayers": ["default", "shift", "symbol", "number"],
    "supportedModes": ["pinyin", "english"]
  },
  "layout": {
    "direction": "vertical",
    "regions": [
      {
        "id": "candidate_bar",
        "role": "candidate",
        "layoutType": "linear",
        "visible": true,
        "enabled": true,
        "size": {
          "width": "match",
          "height": "48dp"
        },
        "scroll": {
          "enabled": true,
          "direction": "horizontal",
          "paging": false
        },
        "linear": {
          "orientation": "horizontal",
          "gap": 4,
          "gravity": "start"
        },
        "children": [
          {
            "type": "button",
            "id": "candidate_prev",
            "size": {
              "width": "40dp",
              "height": "match"
            },
            "content": {
              "label": "‹"
            },
            "actions": {
              "TAP": {
                "actionType": "PAGE_PREV",
                "payload": {}
              }
            }
          },
          {
            "type": "candidate",
            "id": "candidate_0",
            "layout": {
              "weight": 1
            },
            "content": {
              "label": "${candidate0.text}"
            },
            "actions": {
              "TAP": {
                "actionType": "COMMIT_CANDIDATE",
                "payload": {
                  "index": 0
                }
              }
            }
          },
          {
            "type": "candidate",
            "id": "candidate_1",
            "layout": {
              "weight": 1
            },
            "content": {
              "label": "${candidate1.text}"
            },
            "actions": {
              "TAP": {
                "actionType": "COMMIT_CANDIDATE",
                "payload": {
                  "index": 1
                }
              }
            }
          },
          {
            "type": "button",
            "id": "candidate_next",
            "size": {
              "width": "40dp",
              "height": "match"
            },
            "content": {
              "label": "›"
            },
            "actions": {
              "TAP": {
                "actionType": "PAGE_NEXT",
                "payload": {}
              }
            }
          }
        ]
      },
      {
        "id": "toolbar",
        "role": "toolbar",
        "layoutType": "linear",
        "visible": true,
        "enabled": true,
        "size": {
          "width": "match",
          "height": "40dp"
        },
        "linear": {
          "orientation": "horizontal",
          "gap": 4,
          "gravity": "start"
        },
        "children": [
          {
            "type": "button",
            "id": "toolbar_clipboard",
            "content": {
              "label": "剪贴板"
            },
            "actions": {
              "TAP": {
                "actionType": "OPEN_PANEL",
                "payload": {
                  "panel": "clipboard"
                }
              }
            }
          },
          {
            "type": "button",
            "id": "toolbar_emoji",
            "content": {
              "label": "表情"
            },
            "actions": {
              "TAP": {
                "actionType": "OPEN_PANEL",
                "payload": {
                  "panel": "emoji"
                }
              }
            }
          }
        ]
      },
      {
        "id": "main_keyboard",
        "role": "keyboard",
        "layoutType": "rows",
        "visible": true,
        "enabled": true,
        "size": {
          "width": "match",
          "height": "wrap"
        },
        "children": [
          {
            "type": "row",
            "id": "row_1",
            "linear": {
              "orientation": "horizontal",
              "gap": 4,
              "gravity": "stretch"
            },
            "children": [
              { "type": "key", "id": "q", "layout": { "weight": 1 }, "content": { "label": "q" }, "data": { "keyCode": 113 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "q" } } } },
              { "type": "key", "id": "w", "layout": { "weight": 1 }, "content": { "label": "w" }, "data": { "keyCode": 119 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "w" } } } },
              { "type": "key", "id": "e", "layout": { "weight": 1 }, "content": { "label": "e" }, "data": { "keyCode": 101 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "e" } } } },
              { "type": "key", "id": "r", "layout": { "weight": 1 }, "content": { "label": "r" }, "data": { "keyCode": 114 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "r" } } } },
              { "type": "key", "id": "t", "layout": { "weight": 1 }, "content": { "label": "t" }, "data": { "keyCode": 116 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "t" } } } },
              { "type": "key", "id": "y", "layout": { "weight": 1 }, "content": { "label": "y" }, "data": { "keyCode": 121 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "y" } } } },
              { "type": "key", "id": "u", "layout": { "weight": 1 }, "content": { "label": "u" }, "data": { "keyCode": 117 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "u" } } } },
              { "type": "key", "id": "i", "layout": { "weight": 1 }, "content": { "label": "i" }, "data": { "keyCode": 105 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "i" } } } },
              { "type": "key", "id": "o", "layout": { "weight": 1 }, "content": { "label": "o" }, "data": { "keyCode": 111 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "o" } } } },
              { "type": "key", "id": "p", "layout": { "weight": 1 }, "content": { "label": "p" }, "data": { "keyCode": 112 }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "p" } } } }
            ]
          },
          {
            "type": "row",
            "id": "row_2",
            "linear": {
              "orientation": "horizontal",
              "gap": 4,
              "gravity": "stretch"
            },
            "children": [
              { "type": "spacer", "id": "left_pad_r2", "layout": { "weight": 0.5 } },
              { "type": "key", "id": "a", "layout": { "weight": 1 }, "content": { "label": "a" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "a" } } } },
              { "type": "key", "id": "s", "layout": { "weight": 1 }, "content": { "label": "s" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "s" } } } },
              { "type": "key", "id": "d", "layout": { "weight": 1 }, "content": { "label": "d" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "d" } } } },
              { "type": "key", "id": "f", "layout": { "weight": 1 }, "content": { "label": "f" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "f" } } } },
              { "type": "key", "id": "g", "layout": { "weight": 1 }, "content": { "label": "g" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "g" } } } },
              { "type": "key", "id": "h", "layout": { "weight": 1 }, "content": { "label": "h" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "h" } } } },
              { "type": "key", "id": "j", "layout": { "weight": 1 }, "content": { "label": "j" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "j" } } } },
              { "type": "key", "id": "k", "layout": { "weight": 1 }, "content": { "label": "k" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "k" } } } },
              { "type": "key", "id": "l", "layout": { "weight": 1 }, "content": { "label": "l" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "l" } } } },
              { "type": "spacer", "id": "right_pad_r2", "layout": { "weight": 0.5 } }
            ]
          },
          {
            "type": "row",
            "id": "row_3",
            "linear": {
              "orientation": "horizontal",
              "gap": 4,
              "gravity": "stretch"
            },
            "children": [
              {
                "type": "button",
                "id": "shift",
                "layout": {
                  "weight": 1.5
                },
                "content": {
                  "label": "Shift"
                },
                "actions": {
                  "TAP": {
                    "actionType": "TOGGLE_SHIFT",
                    "payload": {}
                  }
                }
              },
              { "type": "key", "id": "z", "layout": { "weight": 1 }, "content": { "label": "z" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "z" } } } },
              { "type": "key", "id": "x", "layout": { "weight": 1 }, "content": { "label": "x" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "x" } } } },
              { "type": "key", "id": "c", "layout": { "weight": 1 }, "content": { "label": "c" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "c" } } } },
              { "type": "key", "id": "v", "layout": { "weight": 1 }, "content": { "label": "v" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "v" } } } },
              { "type": "key", "id": "b", "layout": { "weight": 1 }, "content": { "label": "b" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "b" } } } },
              { "type": "key", "id": "n", "layout": { "weight": 1 }, "content": { "label": "n" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "n" } } } },
              { "type": "key", "id": "m", "layout": { "weight": 1 }, "content": { "label": "m" }, "actions": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "m" } } } },
              {
                "type": "button",
                "id": "backspace",
                "layout": {
                  "weight": 1.5
                },
                "content": {
                  "label": "⌫"
                },
                "actions": {
                  "TAP": {
                    "actionType": "DELETE",
                    "payload": {
                      "count": 1
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "row",
            "id": "row_4",
            "linear": {
              "orientation": "horizontal",
              "gap": 4,
              "gravity": "stretch"
            },
            "children": [
              {
                "type": "button",
                "id": "switch_number",
                "layout": {
                  "weight": 1.2
                },
                "content": {
                  "label": "123"
                },
                "actions": {
                  "TAP": {
                    "actionType": "SWITCH_LAYER",
                    "payload": {
                      "layer": "number"
                    }
                  }
                }
              },
              {
                "type": "button",
                "id": "switch_lang",
                "layout": {
                  "weight": 1.2
                },
                "content": {
                  "label": "中英"
                },
                "actions": {
                  "TAP": {
                    "actionType": "SWITCH_MODE",
                    "payload": {
                      "mode": "english"
                    }
                  }
                }
              },
              {
                "type": "key",
                "id": "space",
                "layout": {
                  "weight": 4
                },
                "content": {
                  "label": "空格"
                },
                "actions": {
                  "TAP": {
                    "actionType": "SPACE",
                    "payload": {}
                  }
                }
              },
              {
                "type": "button",
                "id": "enter",
                "layout": {
                  "weight": 1.5
                },
                "content": {
                  "label": "回车"
                },
                "actions": {
                  "TAP": {
                    "actionType": "ENTER",
                    "payload": {}
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}