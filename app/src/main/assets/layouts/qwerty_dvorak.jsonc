{
  // Common mobile geometry with Dvorak letter order.
  "schemaVersion": "1.0.0",
  "id": "qwerty_dvorak",
  "meta": {
    "name": "Dvorak",
    "description": "Dvorak letter layout on common mobile keyboard geometry"
  },
  "root": {
    "type": "grid",
    "id": "keyboard_grid",
    "columns": 10,
    "cells": [
      // Row 1.
      { "key": { "id": "p", "content": { "label": "p" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "p" } } } } }, "col": 0, "row": 0 },
      { "key": { "id": "y", "content": { "label": "y" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "y" } } } } }, "col": 1, "row": 0 },
      { "key": { "id": "f", "content": { "label": "f" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "f" } } } } }, "col": 2, "row": 0 },
      { "key": { "id": "g", "content": { "label": "g" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "g" } } } } }, "col": 3, "row": 0 },
      { "key": { "id": "c", "content": { "label": "c" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "c" } } } } }, "col": 4, "row": 0 },
      { "key": { "id": "r", "content": { "label": "r" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "r" } } } } }, "col": 5, "row": 0 },
      { "key": { "id": "l", "content": { "label": "l" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "l" } } } } }, "col": 6, "row": 0 },
      { "key": { "id": "a", "content": { "label": "a" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "a" } } } } }, "col": 7, "row": 0 },
      { "key": { "id": "o", "content": { "label": "o" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "o" } } } } }, "col": 8, "row": 0 },
      { "key": { "id": "e", "content": { "label": "e" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "e" } } } } }, "col": 9, "row": 0 },

      // Row 2, shifted by half a key.
      { "key": { "id": "u", "content": { "label": "u" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "u" } } } } }, "col": 0.5, "row": 1 },
      { "key": { "id": "i", "content": { "label": "i" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "i" } } } } }, "col": 1.5, "row": 1 },
      { "key": { "id": "d", "content": { "label": "d" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "d" } } } } }, "col": 2.5, "row": 1 },
      { "key": { "id": "h", "content": { "label": "h" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "h" } } } } }, "col": 3.5, "row": 1 },
      { "key": { "id": "t", "content": { "label": "t" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "t" } } } } }, "col": 4.5, "row": 1 },
      { "key": { "id": "n", "content": { "label": "n" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "n" } } } } }, "col": 5.5, "row": 1 },
      { "key": { "id": "s", "content": { "label": "s" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "s" } } } } }, "col": 6.5, "row": 1 },
      { "key": { "id": "q", "content": { "label": "q" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "q" } } } } }, "col": 7.5, "row": 1 },
      { "key": { "id": "j", "content": { "label": "j" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "j" } } } } }, "col": 8.5, "row": 1 },

      // Row 3.
      { "key": { "id": "shift", "styleRef": "key_function", "content": { "label": "@string/keyboard_key_shift", "icon": "ic_shift_filled" }, "actions": { "gestures": { "TAP": { "actionType": "CYCLE_LAYER", "payload": { "layers": ["NORMAL", "SHIFTED"] } } } } }, "col": 0, "row": 2, "colSpan": 1.5 },
      { "key": { "id": "k", "content": { "label": "k" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "k" } } } } }, "col": 1.5, "row": 2 },
      { "key": { "id": "x", "content": { "label": "x" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "x" } } } } }, "col": 2.5, "row": 2 },
      { "key": { "id": "b", "content": { "label": "b" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "b" } } } } }, "col": 3.5, "row": 2 },
      { "key": { "id": "m", "content": { "label": "m" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "m" } } } } }, "col": 4.5, "row": 2 },
      { "key": { "id": "w", "content": { "label": "w" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "w" } } } } }, "col": 5.5, "row": 2 },
      { "key": { "id": "v", "content": { "label": "v" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "v" } } } } }, "col": 6.5, "row": 2 },
      { "key": { "id": "z", "content": { "label": "z" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "z" } } } } }, "col": 7.5, "row": 2 },
      { "key": { "id": "backspace", "styleRef": "key_function", "content": { "label": "@string/keyboard_key_backspace", "icon": "ic_backspace_modern" }, "actions": { "gestures": { "TAP": { "actionType": "DELETE", "payload": { "count": 1 } }, "LONG_PRESS": { "actionType": "DELETE", "payload": { "count": 10 } } } }, "repeatable": true }, "col": 8.5, "row": 2, "colSpan": 1.5 },

      // Row 4.
      { "key": { "id": "sym", "styleRef": "key_function", "content": { "label": "?123", "icon": "ic_symbols" }, "actions": { "gestures": { "TAP": { "actionType": "OPEN_PANEL", "payload": { "panel": "SYMBOL" } } } } }, "col": 0, "row": 3, "colSpan": 1.5 },
      { "key": { "id": "lang", "styleRef": "key_function", "content": { "label": "@string/keyboard_key_language", "icon": "ic_language_switch" }, "actions": { "gestures": { "TAP": { "actionType": "SWITCH_LOCALE" } } } }, "col": 1.5, "row": 3 },
      { "key": { "id": "comma", "styleRef": "key_function", "content": { "label": "," }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "," } } } } }, "col": 2.5, "row": 3 },
      { "key": { "id": "space", "styleRef": "key_space", "content": { "label": "@string/keyboard_key_space", "icon": "ic_space" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": " " } } } } }, "col": 3.5, "row": 3, "colSpan": 3.5 },
      { "key": { "id": "period", "styleRef": "key_function", "content": { "label": "." }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "." } } } } }, "col": 7, "row": 3 },
      { "key": { "id": "enter", "styleRef": "key_action", "content": { "label": "@string/keyboard_key_enter", "icon": "ic_enter_modern" }, "actions": { "gestures": { "TAP": { "actionType": "ENTER" } } } }, "col": 8, "row": 3, "colSpan": 2 }
    ]
  },
  "supportedLayers": ["NORMAL", "SHIFTED"]
}
