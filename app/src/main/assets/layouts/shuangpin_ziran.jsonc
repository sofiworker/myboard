{
  // Common mobile layout for Ziran Shuangpin.
  "schemaVersion": "1.0.0",
  "id": "shuangpin_ziran",
  "meta": {
    "name": "Ziran Shuangpin",
    "description": "Ziran Shuangpin keyboard layout"
  },
  "root": {
    "type": "grid",
    "id": "keyboard_grid",
    "columns": 10,
    "cells": [
      // Row 1: q w e r t y u i o p
      { "key": { "id": "q", "content": { "label": "q", "hint": { "TOP_CENTER": "iu" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "q" } } } } }, "col": 0, "row": 0 },
      { "key": { "id": "w", "content": { "label": "w", "hint": { "TOP_CENTER": "ei" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "w" } } } } }, "col": 1, "row": 0 },
      { "key": { "id": "e", "content": { "label": "e", "hint": { "TOP_CENTER": "e" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "e" } } } } }, "col": 2, "row": 0 },
      { "key": { "id": "r", "content": { "label": "r", "hint": { "TOP_CENTER": "uan" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "r" } } } } }, "col": 3, "row": 0 },
      { "key": { "id": "t", "content": { "label": "t", "hint": { "TOP_CENTER": "ue" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "t" } } } } }, "col": 4, "row": 0 },
      { "key": { "id": "y", "content": { "label": "y", "hint": { "TOP_CENTER": "un" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "y" } } } } }, "col": 5, "row": 0 },
      { "key": { "id": "u", "content": { "label": "u", "hint": { "TOP_CENTER": "sh" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "u" } } } } }, "col": 6, "row": 0 },
      { "key": { "id": "i", "content": { "label": "i", "hint": { "TOP_CENTER": "ch" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "i" } } } } }, "col": 7, "row": 0 },
      { "key": { "id": "o", "content": { "label": "o", "hint": { "TOP_CENTER": "uo" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "o" } } } } }, "col": 8, "row": 0 },
      { "key": { "id": "p", "content": { "label": "p", "hint": { "TOP_CENTER": "ie" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "p" } } } } }, "col": 9, "row": 0 },

      // Row 2: a s d f g h j k l, shifted by half a key.
      { "key": { "id": "a", "content": { "label": "a", "hint": { "TOP_CENTER": "a" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "a" } } } } }, "col": 0.5, "row": 1 },
      { "key": { "id": "s", "content": { "label": "s", "hint": { "TOP_CENTER": "ong" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "s" } } } } }, "col": 1.5, "row": 1 },
      { "key": { "id": "d", "content": { "label": "d", "hint": { "TOP_CENTER": "iang" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "d" } } } } }, "col": 2.5, "row": 1 },
      { "key": { "id": "f", "content": { "label": "f", "hint": { "TOP_CENTER": "en" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "f" } } } } }, "col": 3.5, "row": 1 },
      { "key": { "id": "g", "content": { "label": "g", "hint": { "TOP_CENTER": "eng" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "g" } } } } }, "col": 4.5, "row": 1 },
      { "key": { "id": "h", "content": { "label": "h", "hint": { "TOP_CENTER": "ang" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "h" } } } } }, "col": 5.5, "row": 1 },
      { "key": { "id": "j", "content": { "label": "j", "hint": { "TOP_CENTER": "an" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "j" } } } } }, "col": 6.5, "row": 1 },
      { "key": { "id": "k", "content": { "label": "k", "hint": { "TOP_CENTER": "ao" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "k" } } } } }, "col": 7.5, "row": 1 },
      { "key": { "id": "l", "content": { "label": "l", "hint": { "TOP_CENTER": "ai" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "l" } } } } }, "col": 8.5, "row": 1 },

      // Row 3: shift z x c v b n m backspace.
      { "key": { "id": "shift", "styleRef": "key_function", "content": { "label": "@string/keyboard_key_shift", "icon": "ic_shift_filled" }, "actions": { "gestures": { "TAP": { "actionType": "CYCLE_LAYER", "payload": { "layers": ["NORMAL", "SHIFTED"] } } } } }, "col": 0, "row": 2, "colSpan": 1.5 },
      { "key": { "id": "z", "content": { "label": "z", "hint": { "TOP_CENTER": "ou" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "z" } } } } }, "col": 1.5, "row": 2 },
      { "key": { "id": "x", "content": { "label": "x", "hint": { "TOP_CENTER": "ia" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "x" } } } } }, "col": 2.5, "row": 2 },
      { "key": { "id": "c", "content": { "label": "c", "hint": { "TOP_CENTER": "iao" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "c" } } } } }, "col": 3.5, "row": 2 },
      { "key": { "id": "v", "content": { "label": "v", "hint": { "TOP_CENTER": "zh" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "v" } } } } }, "col": 4.5, "row": 2 },
      { "key": { "id": "b", "content": { "label": "b", "hint": { "TOP_CENTER": "in" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "b" } } } } }, "col": 5.5, "row": 2 },
      { "key": { "id": "n", "content": { "label": "n", "hint": { "TOP_CENTER": "iao" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "n" } } } } }, "col": 6.5, "row": 2 },
      { "key": { "id": "m", "content": { "label": "m", "hint": { "TOP_CENTER": "ian" } }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "m" } } } } }, "col": 7.5, "row": 2 },
      { "key": { "id": "backspace", "styleRef": "key_function", "content": { "label": "@string/keyboard_key_backspace", "icon": "ic_backspace_modern" }, "actions": { "gestures": { "TAP": { "actionType": "DELETE", "payload": { "count": 1 } }, "LONG_PRESS": { "actionType": "DELETE", "payload": { "count": 10 } } } }, "repeatable": true }, "col": 8.5, "row": 2, "colSpan": 1.5 },

      // Row 4: symbols, locale, punctuation, space, punctuation, enter.
      { "key": { "id": "sym", "styleRef": "key_function", "content": { "label": "?123", "icon": "ic_symbols" }, "actions": { "gestures": { "TAP": { "actionType": "OPEN_PANEL", "payload": { "panel": "SYMBOL" } } } } }, "col": 0, "row": 3, "colSpan": 1.5 },
      { "key": { "id": "lang", "styleRef": "key_function", "content": { "label": "@string/keyboard_key_language", "icon": "ic_language_switch" }, "actions": { "gestures": { "TAP": { "actionType": "SWITCH_LOCALE" } } } }, "col": 1.5, "row": 3 },
      { "key": { "id": "comma", "styleRef": "key_function", "content": { "label": "," }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "," } } } } }, "col": 2.5, "row": 3 },
      { "key": { "id": "space", "styleRef": "key_space", "content": { "label": "@string/keyboard_key_space", "icon": "ic_space" }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": " " } } } } }, "col": 3.5, "row": 3, "colSpan": 3.5 },
      { "key": { "id": "period", "styleRef": "key_function", "content": { "label": "." }, "actions": { "gestures": { "TAP": { "actionType": "PUSH_TOKEN", "payload": { "token": "." } } } } }, "col": 7, "row": 3 },
      { "key": { "id": "enter", "styleRef": "key_action", "content": { "label": "@string/keyboard_key_enter", "icon": "ic_enter_modern" }, "actions": { "gestures": { "TAP": { "actionType": "ENTER" } } } }, "col": 8, "row": 3, "colSpan": 2 }
    ]
  },
  "supportedLayers": ["NORMAL", "SHIFTED"]
}
