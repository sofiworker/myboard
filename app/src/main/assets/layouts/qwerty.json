{
  "schemaVersion": 1,
  "id": "qwerty",
  "meta": {
    "name": "QWERTY",
    "locale": "en-US",
    "tags": ["latin", "qwerty"]
  },
  "templates": {
    "char": { "role": "character" },
    "action": { "role": "action" },
    "repeatable": { "extends": "action", "repeat": { "delay": 400, "interval": 50 } }
  },
  "keys": {
    "q": { "t": "char", "code": 113, "label": "q", "hint": "1" },
    "w": { "t": "char", "code": 119, "label": "w", "hint": "2" },
    "e": { "t": "char", "code": 101, "label": "e", "hint": "3" },
    "r": { "t": "char", "code": 114, "label": "r", "hint": "4" },
    "t": { "t": "char", "code": 116, "label": "t", "hint": "5" },
    "y": { "t": "char", "code": 121, "label": "y", "hint": "6" },
    "u": { "t": "char", "code": 117, "label": "u", "hint": "7" },
    "i": { "t": "char", "code": 105, "label": "i", "hint": "8" },
    "o": { "t": "char", "code": 111, "label": "o", "hint": "9" },
    "p": { "t": "char", "code": 112, "label": "p", "hint": "0" },
    "a": { "t": "char", "code": 97, "label": "a" },
    "s": { "t": "char", "code": 115, "label": "s" },
    "d": { "t": "char", "code": 100, "label": "d" },
    "f": { "t": "char", "code": 102, "label": "f" },
    "g": { "t": "char", "code": 103, "label": "g" },
    "h": { "t": "char", "code": 104, "label": "h" },
    "j": { "t": "char", "code": 106, "label": "j" },
    "k": { "t": "char", "code": 107, "label": "k" },
    "l": { "t": "char", "code": 108, "label": "l" },
    "z": { "t": "char", "code": 122, "label": "z" },
    "x": { "t": "char", "code": 120, "label": "x" },
    "c": { "t": "char", "code": 99, "label": "c" },
    "v": { "t": "char", "code": 118, "label": "v" },
    "b": { "t": "char", "code": 98, "label": "b" },
    "n": { "t": "char", "code": 110, "label": "n" },
    "m": { "t": "char", "code": 109, "label": "m" },
    "shift": { "t": "action", "icon": "⇧", "action": "toggleShift", "weight": 1.5 },
    "backspace": { "t": "repeatable", "icon": "⌫", "action": "delete", "weight": 2 },
    "space": { "t": "action", "label": " ", "action": "commitText", "weight": 6 },
    "enter": { "t": "action", "icon": "↵", "action": "editorAction", "weight": 2 },
    "comma": { "t": "char", "code": 44, "label": "," },
    "period": { "t": "char", "code": 46, "label": "." },
    "sym": { "t": "action", "label": "?123", "action": "switchSymbols", "weight": 1.5 },
    "lang": { "t": "action", "icon": "🌐", "action": "switchLanguage", "weight": 1 }
  },
  "rows": [
    { "id": "r1", "keys": ["q","w","e","r","t","y","u","i","o","p"] },
    { "id": "r2", "keys": ["a","s","d","f","g","h","j","k","l"] },
    { "id": "r3", "keys": ["shift","z","x","c","v","b","n","m","backspace"] },
    { "id": "r4", "keys": ["sym","lang","comma","space","period","enter"] }
  ],
  "arrangements": {
    "alpha": { "rows": ["r1","r2","r3","r4"] }
  },
  "geometry": {
    "height": { "dp": 260, "min": 190, "max": 360 },
    "gap": { "h": 6, "v": 8 },
    "padding": { "all": 4 }
  }
}
